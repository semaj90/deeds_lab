# Phase 87 Environment Configuration
# Use with: node --env-file=.env.phase87 scripts/fastmcp-server.mjs

# PostgreSQL (Docker container on port 5434)
DATABASE_URL=postgresql://user:pass@127.0.0.1:5434/legal

# Qdrant Vector Store
QDRANT_URL=http://127.0.0.1:6333

# Ollama LLM/Embedding
OLLAMA_URL=http://127.0.0.1:11434

# Redis Cache
REDIS_URL=redis://127.0.0.1:6379

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# CouchDB (to be added)
# COUCHDB_URL=http://admin:legal_ai_pass@127.0.0.1:5984

# Knowledge Plane Service (to be deployed)
# KNOWLEDGE_PLANE_URL=http://127.0.0.1:8765
