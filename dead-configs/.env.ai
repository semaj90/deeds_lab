# AI Assistant Environment Configuration # Using gemma:legal with legal-bert fallback # Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434 OLLAMA_MODEL=gemma2:9b-instruct-q4_0 OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_FALLBACK_MODEL=legal-bert OLLAMA_EMBEDDING_FALLBACK=all-minilm OLLAMA_TIMEOUT=60000 OLLAMA_GPU_LAYERS=35
OLLAMA_NUM_THREADS=8 # Model Selection Strategy AI_FALLBACK_CHAIN=gemma2:9b-instruct-q4_0,legal-bert
AI_LEGAL_DETECTION=true AI_AUTO_SELECT_MODEL=true # Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deeds_web DATABASE_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT=30000 # Redis Configuration REDIS_URL=redis://localhost:6379 REDIS_CACHE_TTL=3600
REDIS_MAX_RETRIES=3 # Vector Database Configuration QDRANT_URL=http://localhost:6333 QDRANT_COLLECTION=legal_documents
VECTOR_DIMENSIONS=768 # Neo4j Configuration (for knowledge graph) NEO4J_URI=bolt://localhost:7687 NEO4J_USER=neo4j
NEO4J_PASSWORD=password # Message Queue Configuration RABBITMQ_URL=amqp://localhost:5672 NATS_URL=nats://localhost:4222
# GPU Configuration ENABLE_GPU=true CUDA_VISIBLE_DEVICES=0 GPU_MEMORY_FRACTION=0.8 # WebGPU Configuration (for
client-side) ENABLE_WEBGPU=true WEBGPU_BACKEND=webgpu # Performance Settings PARALLEL_WORKERS=32 BATCH_SIZE=32
MAX_CONCURRENT_REQUESTS=4 CACHE_ENABLED=true PROACTIVE_CACHING=true # SOM (Self-Organizing Map) Configuration
SOM_ENABLED=true SOM_MAP_SIZE=100x100 SOM_LEARNING_RATE=0.5 SOM_ITERATIONS=1000 # Feature Flags
ENABLE_MULTI_MODAL_INDEXING=true ENABLE_REINFORCEMENT_LEARNING=false ENABLE_IDLE_TIME_OPTIMIZATION=true
ENABLE_STREAMING=true ENABLE_INTELLIGENT_FALLBACK=true # Client Configuration VITE_ENABLE_3D_CANVAS=true
VITE_CANVAS_RENDERER=webgpu VITE_ENABLE_SERVICE_WORKER=true VITE_ENABLE_OFFLINE_MODE=true # Security
JWT_SECRET=your-secret-key-here ENCRYPTION_KEY=your-encryption-key-here # Monitoring ENABLE_MONITORING=true
ELK_STACK_URL=http://localhost:9200 PROMETHEUS_PORT=9090 # Development NODE_ENV=development DEBUG=true LOG_LEVEL=info #
Legal Model Specific Settings LEGAL_MODEL_TEMPERATURE=0.5 LEGAL_MODEL_TOP_P=0.85 LEGAL_MODEL_TOP_K=30
LEGAL_CONTEXT_WINDOW=8192 LEGAL_BERT_CONTEXT=512
