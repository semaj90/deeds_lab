# ============================================================================
# Phase 72 - Standardized Infrastructure Configuration
# ============================================================================
# Redis, Ollama, Qdrant, KAG Storage, Safety Gates, Debug settings
# Last updated: Session 3 (Redis standardized on 6379)
# ============================================================================

# ============================================================================
# 1. REDIS - KAG Storage + Cache (Standardized on 6379)
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Phase 72 KAG prefix for key namespacing
KAG_PREFIX=phase72:kag
KAG_REDIS_DB=0

# ============================================================================
# 2. OLLAMA - LLM + Embeddings (3 Models)
# ============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3-legal:latest
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_FAST_FIX_MODEL=gemma2:2b
OLLAMA_TIMEOUT=30000

# ============================================================================
# 3. QDRANT - Vector Search Database
# ============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=phase72_error_patterns
QDRANT_VECTOR_SIZE=768

# ============================================================================
# 4. PHASE 72 Configuration - Batch, Retry, Verification
# ============================================================================
PHASE72_BATCH_SIZE=100
PHASE72_MAX_RETRIES=3
PHASE72_VERIFY_COMMAND=npx tsc --noEmit
PHASE72_EMBED_VERIFIED_ONLY=true
PHASE72_AUTO_TAG=true
PHASE72_CACHE_HIT_THRESHOLD=0.85
PHASE72_CACHE_TTL=604800

# ============================================================================
# 5. PHASE 72 Safety Gates - Feature Flags
# ============================================================================
PHASE72_DRY_RUN=false
PHASE72_ENABLE_KAG=true
PHASE72_ENABLE_QDRANT=true
PHASE72_ENABLE_LLM_FALLBACK=true

# ============================================================================
# 6. Debug & Logging
# ============================================================================
DEBUG=phase72:*
LOG_LEVEL=info
VERBOSE=false

# ============================================================================
# 7. SvelteKit + PostgreSQL (Optional - shared with main app)
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legal_ai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DEV_BYPASS_AUTH=true
NODE_OPTIONS=--max-old-space-size=3072

# ============================================================================
# 8. Legacy/Deprecated (Maintained for backward compatibility)
# ============================================================================
# GO_INGEST_URL=http://127.0.0.1:8089
# SIMD_JSON_ACCEL_URL=http://127.0.0.1:8103
# PHASE72_EMBEDDING_MODEL=embeddinggemma:latest (use OLLAMA_EMBEDDING_MODEL)
# PHASE72_SUMMARY_MODEL=gemma3-legal:latest (use OLLAMA_MODEL)
