# =============================================================================
# Error-Brain Configuration (Phase 15-38)
# =============================================================================
# See ERROR_BRAIN_GUIDE.md for full documentation

# Master kill switch - must be true to enable error-brain system
ERROR_BRAIN_ENABLED=false

# Transport layer: none|sse|redis|both
# - none: No event delivery (default, safest)
# - sse: In-memory fanout for current process
# - redis: Pub/sub + stream across instances
# - both: Parallel delivery to SSE + Redis
ERROR_BRAIN_TRANSPORT=none

# Patch application mode: off|safe|full
# - off: Analysis only, no modifications (default, safest)
# - safe: Apply patches with confidence >= 0.7
# - full: Apply all patches regardless of confidence
ERROR_BRAIN_APPLY_MODE=off

# Safety: Force dry-run mode (true = no writes)
ERROR_BRAIN_DRY_RUN=true

# Safety cap: Max lines per patch (reject larger changes)
ERROR_BRAIN_MAX_PATCH_SIZE=100

# Confidence threshold: Min confidence to apply (0.0 - 1.0)
ERROR_BRAIN_CONFIDENCE_MIN=0.7

# Security: Token for API access (optional, defaults to localhost-only)
# ERROR_BRAIN_TOKEN=your-secret-token-here

# =============================================================================
