# Legal AI Platform - Complete Database Configuration # Copy this to .env after ensuring all services are running #
============================================ # DATABASE CONNECTIONS (Primary) #
============================================ DATABASE_URL=postgresql://postgres:123456@localhost:5432/legal_ai_db
DEV_DATABASE_URL=postgresql://postgres:123456@localhost:5432/legal_ai_db # PostgreSQL Direct Connection
POSTGRES_HOST=localhost POSTGRES_PORT=5432 POSTGRES_DB=legal_ai_db POSTGRES_USER=postgres POSTGRES_PASSWORD=123456
POSTGRES_SSL=false # ============================================ # REDIS CONFIGURATION #
============================================ REDIS_URL=redis://localhost:6379 REDIS_HOST=localhost REDIS_PORT=6379
REDIS_PASSWORD= REDIS_DB=0 # ============================================ # NEO4J CONFIGURATION #
============================================ NEO4J_URI=bolt://localhost:7687 NEO4J_USER=neo4j NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j # ============================================ # CORE SERVICE URLS (Local Windows Native) #
============================================ PUBLIC_API_URL=http://localhost:5173
PUBLIC_RAG_SERVICE_URL=http://localhost:8094 PUBLIC_UPLOAD_SERVICE_URL=http://localhost:8093
PUBLIC_VECTOR_SERVICE_URL=http://localhost:8095 PUBLIC_CUDA_SERVICE_URL=http://localhost:8096
PUBLIC_LOAD_BALANCER_URL=http://localhost:8224 PUBLIC_ENHANCED_API_URL=http://localhost:8202 #
============================================ # AI SERVICES CONFIGURATION # ============================================
OLLAMA_URL=http://localhost:11434 OLLAMA_API_URL=http://localhost:11434 OLLAMA_MODEL=gemma:legal
EMBEDDING_MODEL=nomic-embed-text:latest # Ollama Performance Settings OLLAMA_NUM_PARALLEL=4 OLLAMA_FLASH_ATTENTION=true
OLLAMA_GPU_MEMORY_FRACTION=0.8 # ============================================ # STORAGE & CACHING #
============================================ QDRANT_URL=http://localhost:6333 QDRANT_API_KEY=
QDRANT_COLLECTION=legal_documents MINIO_URL=http://localhost:9000 MINIO_HOST=localhost MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin MINIO_SECRET_KEY=minioadmin MINIO_BUCKET=legal-documents MINIO_SSL=false #
============================================ # AUTHENTICATION & SECURITY # ============================================
JWT_SECRET=your-super-secure-jwt-secret-key-change-in-production
AUTH_SECRET=your-super-secure-auth-secret-key-change-in-production
SESSION_SECRET=your-super-secure-session-secret-key-change-in-production # ============================================
# APPLICATION SETTINGS # ============================================ NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5173 VITE_DATABASE_URL=postgresql://postgres:123456@localhost:5432/legal_ai_db #
Logging LOG_LEVEL=info DEBUG_SQL=false VERBOSE_LOGGING=true # Performance MAX_UPLOAD_SIZE=100MB REQUEST_TIMEOUT=30000
DATABASE_POOL_SIZE=10 # ============================================ # RABBITMQ (Optional - for background workers) #
============================================ RABBITMQ_URL=amqp://guest:guest@localhost:5672 RABBITMQ_EXCHANGE=legal_ai
RABBITMQ_QUEUE=document_processing # ============================================ # FEATURE FLAGS #
============================================ ENABLE_GPU_PROCESSING=true ENABLE_VECTOR_SEARCH=true
ENABLE_REAL_TIME_CHAT=true ENABLE_FILE_UPLOAD=true ENABLE_DOCUMENT_OCR=true #
============================================ # DEVELOPMENT SETTINGS # ============================================
DISABLE_AUTH_IN_DEV=false MOCK_AI_RESPONSES=false ENABLE_DEBUG_LOGGING=true HOT_RELOAD=true #
============================================ # PRODUCTION OVERRIDES (Comment out for dev) #
============================================ # NODE_ENV=production # PUBLIC_BASE_URL=https://your-domain.com #
POSTGRES_SSL=true # DISABLE_AUTH_IN_DEV=false
