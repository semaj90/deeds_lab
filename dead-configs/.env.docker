# Environment variables for SvelteKit + Docker + Authentication # Copy this to .env in your sveltekit-frontend directory
# === CORE SVELTEKIT === NODE_ENV=development PORT=5174 ORIGIN=http://localhost:5174 # === DATABASE (PostgreSQL with
pgvector) === DATABASE_URL=postgresql://legal_admin:123456@localhost:5433/legal_ai_db POSTGRES_HOST=localhost
POSTGRES_PORT=5433 POSTGRES_DB=legal_ai_db POSTGRES_USER=legal_admin POSTGRES_PASSWORD=123456 # === REDIS CACHE ===
REDIS_URL=redis://localhost:6379 REDIS_HOST=localhost REDIS_PORT=6379 # === AUTHENTICATION (Lucia v3) === # Generate
strong secrets in production! AUTH_SECRET=your-super-secret-auth-key-minimum-32-characters-long-change-in-production
JWT_SECRET=your-jwt-secret-key-for-additional-tokens-change-in-production # Session configuration
SESSION_COOKIE_NAME=legal_ai_session SESSION_EXPIRES_IN=30d # === DYNAMIC PORTS === DYNAMIC_PORTS=true VITE_PORT=5174
VITE_HMR_PORT=24678 PROXY_PORT=8080 # === DOCKER CONFIGURATION === # Use these when running in Docker #
DATABASE_URL=postgresql://legal_admin:123456@postgres:5432/legal_ai_db # REDIS_URL=redis://redis:6379 #
OLLAMA_BASE_URL=http://host.docker.internal:11434 # === EXTERNAL SERVICES === OLLAMA_BASE_URL=http://localhost:11434
MINIO_ENDPOINT=localhost:9000 MINIO_ACCESS_KEY=minio MINIO_SECRET_KEY=minio123 # === PERFORMANCE ===
NODE_OPTIONS=--max-old-space-size=3072 ENABLE_GPU=true RTX_3060_OPTIMIZATION=true CONTEXT7_MULTICORE=true
OLLAMA_GPU_LAYERS=30 # === DEVELOPMENT === VITE_DEV_SERVER_HOST=0.0.0.0 VITE_DEV_SERVER_PORT=5174
