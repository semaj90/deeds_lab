# ============================================================================
# Legal AI Platform - 384-Dimension Vector Stack Configuration
# ============================================================================
# Purpose: Production-ready environment variables for Docker Desktop deployment
# Date: 2025-10-17
# Model: embeddinggemma:latest (384 dimensions)
# ============================================================================

# ============================================================================
# Database Configuration (PostgreSQL + pgvector)
# ============================================================================
DATABASE_URL=postgresql://legal_admin:123456@localhost:5432/legal_ai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=legal_admin
POSTGRES_PASSWORD=123456
POSTGRES_DB=legal_ai_db

# ============================================================================
# Vector Search Configuration
# ============================================================================

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Embedding Model
EMBEDDING_MODEL=embeddinggemma:latest
VECTOR_DIMENSIONS=384

# Ollama AI Service
OLLAMA_URL=http://localhost:11434
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# ============================================================================
# Cache Configuration
# ============================================================================

# Redis Cache
REDIS_URL=redis://:redis@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB=0
REDIS_TTL=3600

# Enable embedding cache
ENABLE_EMBEDDING_CACHE=true
EMBEDDING_CACHE_TTL=86400

# ============================================================================
# Message Queue Configuration
# ============================================================================

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_ENABLED=true

# Queue Names
EMBEDDING_QUEUE=embedding_jobs
DOCUMENT_QUEUE=document_processing
TENSOR_QUEUE=tensor_jobs

# ============================================================================
# Graph Database Configuration
# ============================================================================

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ============================================================================
# Object Storage Configuration
# ============================================================================

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET=legal-docs

# ============================================================================
# Application Configuration
# ============================================================================

# Node Environment
NODE_ENV=development
PORT=5173
HOST=127.0.0.1

# API Configuration
API_TIMEOUT=30000
MAX_UPLOAD_SIZE=50mb

# ============================================================================
# Vector Configuration
# ============================================================================

# HNSW Index Parameters
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40

# Batch Processing
EMBEDDING_BATCH_SIZE=100
DATABASE_BATCH_SIZE=1000
SEARCH_LIMIT=50

# Parallel Processing
PARALLEL_REQUESTS=4
MAX_WORKERS=4

# ============================================================================
# Performance Tuning
# ============================================================================

# Cache Settings
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# Connection Pools
POSTGRES_POOL_SIZE=20
POSTGRES_POOL_TIMEOUT=30000
REDIS_POOL_SIZE=10

# Timeouts
DATABASE_TIMEOUT=30000
VECTOR_SEARCH_TIMEOUT=10000
OLLAMA_TIMEOUT=30000

# ============================================================================
# Monitoring & Logging
# ============================================================================

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/app.log

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Health Checks
HEALTH_CHECK_INTERVAL=30000

# ============================================================================
# Security Configuration
# ============================================================================

# API Keys (optional)
API_KEY=
JWT_SECRET=your-secret-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/Disable Features
ENABLE_VECTOR_SEARCH=true
ENABLE_RAG=true
ENABLE_EMBEDDINGS=true
ENABLE_GRAPH_DB=true
ENABLE_OBJECT_STORAGE=true
ENABLE_MESSAGE_QUEUE=true

# Experimental Features
ENABLE_GPU_ACCELERATION=false
ENABLE_QUANTIZATION=false
ENABLE_FAISS_GPU=false

# ============================================================================
# Docker Desktop URLs (for reference)
# ============================================================================

# Access URLs
# PostgreSQL: postgresql://legal_admin:123456@localhost:5432/legal_ai_db
# Qdrant Dashboard: http://localhost:6333/dashboard
# Redis: redis://:redis@localhost:6379/0
# RabbitMQ Management: http://localhost:15672 (guest/guest)
# Neo4j Browser: http://localhost:7474 (neo4j/password)
# MinIO Console: http://localhost:9001 (minioadmin/minioadmin123)
# Ollama API: http://localhost:11434
# SvelteKit App: http://localhost:5173

# ============================================================================
# Quick Start Commands
# ============================================================================

# Start all services:
# docker-compose -f docker-compose-full-stack-384.yml up -d

# Start development server:
# REDIS_PASSWORD=redis npm run dev

# Run benchmarks:
# ./benchmark-384-stack.sh

# Run tests:
# ./test-384-vector-stack.sh

# ============================================================================
# Environment Notes
# ============================================================================

# Model: embeddinggemma:latest
# Dimensions: 384
# Distance Metric: Cosine
# Memory per 1M vectors: ~1.5 GB
# Expected Search Speed: <50ms (Qdrant), <200ms (pgvector)
# Cache Hit Rate Target: >80%

# ============================================================================
# Production Deployment
# ============================================================================

# Before deploying to production:
# 1. Change all default passwords
# 2. Set strong JWT_SECRET
# 3. Configure proper CORS origins
# 4. Enable TLS/SSL for all services
# 5. Set up proper monitoring and alerting
# 6. Configure backup strategies
# 7. Review rate limits
# 8. Enable authentication for all services

