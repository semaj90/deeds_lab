# Unified Legal AI System Environment Configuration # Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/legal_ai_db # Redis Cache REDIS_URL=redis://127.0.0.1:4005
REDIS_HOST=localhost REDIS_PORT=4005 # MinIO Object Storage MINIO_ENDPOINT=localhost MINIO_PORT=9000 MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin MINIO_SECRET_KEY=minioadmin # Qdrant Vector Database QDRANT_URL=http://localhost:6333
QDRANT_API_KEY= # Neo4j Graph Database (for recommendations) NEO4J_URI=bolt://localhost:7687 NEO4J_USER=neo4j
NEO4J_PASSWORD=password # Embedding Service (Local Gemma3 or Nomic API) EMBEDDER_TYPE=local
LOCAL_EMBEDDER_URL=http://localhost:9000/embed NOMIC_API_KEY=your_nomic_api_key_here
EMBEDDING_MODEL=nomic-embed-text-v1.5 # QUIC Go Microservices QUIC_GATEWAY_URL=http://localhost:8080
QUIC_VECTOR_SERVICE_URL=http://localhost:8081 QUIC_SEARCH_SERVICE_URL=http://localhost:8082 # Development
NODE_ENV=development LOG_LEVEL=info
