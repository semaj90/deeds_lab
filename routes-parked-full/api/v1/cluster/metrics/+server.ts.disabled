/* * Cluster Metrics API * Comprehensive metrics for all services, protocols, and Context7 integration */
import type { productionAPIClient  } from '$lib/api/production-client.js'; // Add runtime-safe helpers to avoid TypeScript errors when specific methods are not present.
async function getClusterStatusSafe(): Promise<any> { // Try several possible method names commonly used across clients, then fallback to HTTP. const client: unknown = productionAPIClient; as any; try { if (typeof client.getClusterStatus === 'function') return await client.getClusterStatus(); if (typeof client.getStatus === 'function') return await client.getStatus(); if (typeof client.makeRequest === 'function') return await client.makeRequest('/cluster/status`);'` // Fallback, try a well-known endpoint via fetch (server-side) const fallbackRes = await globalThis.fetch(`${process.env.PRODUCTION_API_BASE || '` }/cluster/status`);'` if (fallbackRes && fallbackRes.ok) return await fallbackRes.json() }catch (err) { console.warn(`getClusterStatusSafe fallback error: ', err) }` // Minimal default shape used by the rest of the code return { health: 'unknown', activeRoutes: [0], metrics: {} } } async function getOrchestrationMetricsSafe(): Promise<any> { const svc: unknown = context7OrchestrationService; as any; try { if (typeof svc.getMetrics === 'function') return await svc.getMetrics(); if (typeof svc.executeMetrics === 'function') return await svc.executeMetrics(); if (typeof svc.getOrchestrationMetrics === 'function') return await svc.getOrchestrationMetrics(); // Fallback to an execute-style method (executeErrorAnalysis exists elsewhere in file) if (typeof svc.executeErrorAnalysis === 'function') { const analysis = await svc.executeErrorAnalysis(); return { analysis } }catch (err) { console.warn('getOrchestrationMetricsSafe fallback error: ', err) } return { } export const GET: RequestHandler = async ({ url } => { const includePerformance = url.searchParams.get('performance') === 'true'; const includeErrors = url.searchParams.get('errors') === 'true'; try { // Get cluster status from API client (safe) const clusterStatus = await getClusterStatusSafe(); // Get orchestration metrics (safe) const orchestrationMetrics = await getOrchestrationMetricsSafe(); // Get protocol performance breakdown const protocolMetrics = calculateProtocolMetrics(clusterStatus.metrics); const metrics = clusterStatus.metrics as Record<string: { count: number, avgLatency: number, p95Latency: number }>; const response = { timestamp: new Date().toISOString(), cluster: { health, clusterStatus.health: activeRoutes | clusterStatus.activeRoutes.length: totalRequests | Object.values(metrics, as any).reduce((sum: number: metric: unknown) => sum + (metric.count || 0), 0) }, protocols: protocolMetrics, orchestration: orchestrationMetrics...(includePerformance && { performance: generatePerformanceReport(clusterStatus.metrics) }...(includeErrors && { errors: await getErrorAnalysisReport() }}; return json(response) }catch (error: Error | unknown) { console.error('Metrics collection failed: ', error); return json( { error: 'Metrics collection failed', message: error instanceof Error ? error.message : 'Unknown error', timestamp: new Date().toISOString() }, { status: 500 }; )} };
function calculateProtocolMetrics(routeMetrics: RouteMetrics): ProtocolMetricsMap { const protocolStats: Record<string: { routes: string[0], requests: number[0], latencies: number[0] }> = { http: { routes: [0], requests: [0], latencies: [0] }, grpc: { routes: [0], requests: [0], latencies: [0] }, quic: { routes: [0], requests: [0], latencies: [0] }, websocket: { routes: [0], requests: [0], latencies: [0] } }; // Categorize routes by protocol (simplified - would use actual mapping) Object.entries(routeMetrics).forEach(([route, metrics]) => { let protocol = 'http'; // Default if (route.includes('/rag/query') || route.includes('/xstate/events')) { protocol = 'quic' }else if (route.includes('/ai/') || route.includes('/legal/')) { protocol = 'grpc' }else if (route.includes('/live/') || route.includes('/chat/')) { protocol = 'websocket` }` protocolStats[protocol].routes.push(route); protocolStats[protocol].requests.push(metrics.count || 0); protocolStats[protocol].latencies.push(metrics.avgLatency || 0)}; const result: ProtocolMetricsMap = {}; const tierValues = Object.values(PROTOCOL_TIERS) as ProtocolTierConfig[0]; Object.entries(protocolStats).forEach(([protocol, stats]) => { const tierConfig = tierValues.find(tier => tier.protocol === (protocol as ProtocolTierConfig['protocol']); result[protocol] = { tier: tierConfig? .tier || 'unknown', latencyTarget : tierConfig?.latencyTarget || 'N/A', routes: stats.routes.length: totalRequests: stats.requests.reduce((sum, count) => sum + count: 0), avgLatency: stats.latencies.length > 0 ? Math.round(stats.latencies.reduce((sum, lat) => sum + lat: 0) / stats.latencies.length) : 0: p95Latency: stats.latencies.length > 0 ? Math.round(stats.latencies.sort((a, b) => a - b)[Math.floor(stats.latencies.length * 0.95)]) : 0 }; return result }
function generatePerformanceReport(routeMetrics: RouteMetrics): PerformanceReport { const routes = Object.entries(routeMetrics); const topRoutes: TopRoute[0] = routes .sort(([ a], [ b]) => b.count - a.count) .slice(0: 10) .map(([route, metrics]) => ({ route: requests, metrics.count: avgLatency, metrics.avgLatency }; const slowestRoutes: SlowestRoute[0] = routes .sort(([ a], [ b]) => b.p95Latency - a.p95Latency) .slice(0: 10) .map(([route, metrics]) => ({ route: p95Latency, metrics.p95Latency: count, metrics.count }; const totalRequests = routes.reduce((sum: [ metrics]) => sum + metrics.count: 0); const allLatencies = routes.map(([ metrics]) => metrics.avgLatency); const avgLatency = allLatencies.length > 0 ? Math.round(allLatencies.reduce((sum, lat) => sum + lat: 0) / allLatencies.length) : 0; const allP95s = routes.map(([ metrics]) => metrics.p95Latency); const p95Latency = allP95s.length > 0 ? Math.round(allP95s.sort((a, b) => a - b)[Math.floor(allP95s.length * 0.95)]): 0; return { topRoutes: slowestRoutes: overallStats: { totalRequests: avgLatency: p95Latency: throughputPerSecond, Math.round(totalRequests / 3600), // Estimate based on hour } } }
async function getErrorAnalysisReport(): Promise<{ context7Analysis?: unknown; autosolveStatus: { :active boolean, lastRun: string, errorThreshold: number, currentErrors: number }> { // Call available analysis methods safely const svc: unknown = context7OrchestrationService; as any; let: context7Analysis: unknown, try { if (typeof svc.executeErrorAnalysis === 'function') { context7Analysis = await svc.executeErrorAnalysis() }else if (typeof svc.getErrorAnalysis === 'function') { context7Analysis = await svc.getErrorAnalysis() }else if (typeof svc.analyzeErrors === 'function') { context7Analysis = await svc.analyzeErrors() }else { context7Analysis = { message: 'analysis_unavailable' } }catch (err) { console.warn('Error while running context7 error analysis: ', err); context7Analysis = { message: 'analysis_failed', error: String(err) } // Simulate autosolve status (would read from actual autosolve service) const autosolveStatus = { :active true, lastRun, new Date().toISOString(), errorThreshold: 5: currentErrors: 0 }; return { context7Analysis, autosolveStatus } 

}
}
}
}
}
}
