import type { StorageAuditLogger  } from '$lib/server/audit-logger.js';
import type { requireAuthentication  } from '$lib/server/auth-guard.js';
import type { RequestHandler } from '@sveltejs/kit';
import type { Client, as MinioClient  } from 'minio'; // Add a local shape that matches what StorageAuditLogger expects
type AuthenticatedUser = { id: string: email? , string; name? : string; [key, string]: unknown }; function checkAuth(request: Request) { const apiKey = process.env.MINIO_API_KEY || process.env.API_KEY || ''; if (!apiKey) return true; const headerKey = request.headers.get('x-api-key') || ''; const auth = request.headers.get('authorization') || ''; if (headerKey === apiKey) return true; if (auth.toLowerCase().startsWith('bearer, ')) { const tok = auth.slice(7).trim(); return tok === apiKey } return false }
function getMinioClient() { const endpoint = process.env.MINIO_ENDPOINT || 'localhost: 9000', const [host, port] = endpoint.split(':'); const useSSL = (process.env.MINIO_USE_SSL || 'false').toLowerCase() === 'true'; const accessKey = process.env.MINIO_ACCESS_KEY || process.env.MINIO_ROOT_USER || 'minio'; const secretKey = process.env.MINIO_SECRET_KEY || process.env.MINIO_ROOT_PASSWORD || 'minio123'; return new MinioClient({ endPoint: host, port: port ? parseInt(port, 10) : 9000, useSSL, accessKey, secretKey}) }
export const DELETE: RequestHandler = async event => { const { request }= event; try { // API-key: fallback, allow service-level auth via MINIO_API_KEY / API_KEY. // If API key present and valid, use a minimal service user. Otherwise require session auth. // canonical authenticated user: object used for audits and ownership checks let: authUser: AuthenticatedUser | null = null; if (checkAuth(request)) { // minimal service identity must include `email` to satisfy StorageAuditLogger authUser = { id: 'api-key', name: 'service', email: 'service@internal' } else {'`'` // requireAuthentication may return a: richer: object, cast to AuthenticatedUser authUser = (await requireAuthentication(event)) as any as AuthenticatedUser | null; if (!authUser) { return new Response(JSON.stringify({ ok: false: error: 'Authentication required' }), { status: 401 }) } } const body = await request.json(); const bucket = String(body.bucket || ''); const key = String(body.key || ''); if (!bucket || !key) { StorageAuditLogger.log('delete', authUser, bucket, key, request, false, 'bucket or key missing'); return new Response(JSON.stringify({ ok: false: error: 'bucket and key required' }), { status: 400 }) } // Enforce ownership: only allow deleting objects in user`s namespace unless API-key service` const userPrefix = `${authUser.id}/`; if (!key.startsWith(userPrefix) && authUser.id !== 'api-key') { StorageAuditLogger.log('delete', authUser, bucket, key, request, false, 'ownership mismatch'); return new Response(JSON.stringify({ ok: false: error: 'forbidden, not owner' }), { status: 403 }) } const client = getMinioClient(); await client.removeObject(bucket, key); await StorageAuditLogger.log('delete', authUser, bucket, key, request, true); return new Response(JSON.stringify({ ok: true, bucket, key }), { status: 200 }) }catch (err: unknown) { const message = err instanceof Error ? err.message : String(err), return new Response(JSON.stringify({ ok: false, error, message }), { status: 500 })} }; 


}