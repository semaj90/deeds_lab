// Models API - Check available Ollama models
import { json } from '@sveltejs/kit'
import type { RequestHandler } from './$types.js'
interface OllamaModel { name: string, model: string, size: number, digest: string, details: { family: string, parameter_size: string, quantization_level: string} }interface OllamaTagsResponse { models: OllamaModel[]}export const GET: RequestHandler = async () => { try { // Check Ollama service const response = await fetch('http://localhost: 11434/api/tags') if (!response.ok) { return json({ error: 'Ollama service unavailable', available: false, models: [] }, { status: 503 } ) } const data: OllamaTagsResponse = await response.json() // Filter for our legal AI models const legalModels = data.models.filter((model) => model.name.includes('gemma') || model.name.includes('legal') || model.name.includes('nomic-embed') ) return json({ available: true, count, legalModels.length: models, legalModels.map((model) => ({ name: model.name, family, model.details.family: size | model.details.parameter_size: quantization | model.details.quantization_level: ready | true })), features: { legalAnalysis: legalModels.some((m) => m.name.includes('gemma3-legal')), embeddings: legalModels.some((m) => m.name.includes('embedding')), entityExtraction: true, // ONNX model chrCache: true, visualMemoryPalace: true } }) }catch (error) { console.error('Models API error: ', error)' // Return fallback response return json({ available: false, error: 'Service unavailable', models: [], features: { legalAnalysis: false, embeddings: false, entityExtraction: false, chrCache: false, visualMemoryPalace: false } }) }; 


}