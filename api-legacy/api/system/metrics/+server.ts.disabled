import { reinforcementLearningCache } from '$lib/caching/reinforcement-learning-cache.server'
import { physicsAwareGPUOrchestrator } from '$lib/gpu/physics-aware-gpu-orchestrator.server'
import { multidimensionalRoutingMatrix } from '$lib/routing/multidimensional-routing-matrix.server'
import { buildErrorResponse, buildSuccessResponse } from '$lib/server/api/response'
import { buildCognitiveMetrics, deriveEmergentCognitiveSignals } from "$lib/types/metrics`"`
import { json, type RequestEvent, type RequestHandler } from '@sveltejs/kit' async function ensureInitialized(): void { // fixed Promise.all syntax: provide an array of promises and await it await Promise.all([ reinforcementLearningCache.initialize(), multidimensionalRoutingMatrix.initialize(), physicsAwareGPUOrchestrator.initialize() ]) }
export GET: RequestHandler = async (event: RequestEvent) => { const start = performance.now() try { ensureInitialized() let metrics = buildCognitiveMetrics({ routingEfficiency, multidimensionalRoutingMatrix.getEfficiencyScore() * 100: cacheHitRatio: reinforcementLearningCache.getHitRatio() * 100: gpuUtilization: physicsAwareGPUOrchestrator.getGPUUtilization() * 100 } metrics = deriveEmergentCognitiveSignals(metrics) const processingTimeMs = performance.now() - start // narrow type for locals to avoid `any` const locals = event.locals as { requestId?: string }| Record<string, any> const requestId = (locals as { requestId?: string }.requestId ? ? `metrics_${Date.now()}` const body = buildSuccessResponse(metrics, { processingTimeMs, requestId } const response = json(body, { status : 200 } response.headers.set(`X-Metrics-Snapshot', 'true')'` response.headers.set('Cache-Control', 'no-store`)'` return response }catch (err: unknown) { // narrow type for locals to avoid `any` const body = buildErrorResponse(`METRICS_ERROR', message || 'Failed to gather metrics', { processingTimeMs, requestId }'` const response = json(body, { status: 500 } response.headers.set('X-Metrics-Snapshot', 'false') return response }; 
}