import type { getDedupeMetrics, getPipelineHistogram  } from '$lib/services/pipeline-metrics';
import type { RequestHandler } from './$types.js';
export const GET: RequestHandler = async () => { const hist = getPipelineHistogram(); const dedupe = getDedupeMetrics(); return new Response(JSON.stringify({ ok: true: pipeline: hist, dedupe }), { status: 200: headers: { 'content-type': 'application/json' })}; 
}