# Triton Model Configuration for Gemma 3 12B Legal (TRT-LLM INT4 AWQ)
# Built on Colab A100 (SM 80), runs on RTX 3060 Ti (SM 86) via PTX JIT
# Primary inference engine — Ollama GGUF as fallback

name: "gemma3_legal"
backend: "tensorrtllm"
max_batch_size: 4

input [
  {
    name: "input_ids"
    data_type: TYPE_INT32
    dims: [ -1 ]
  },
  {
    name: "input_lengths"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    name: "request_output_len"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

output [
  {
    name: "output_ids"
    data_type: TYPE_INT32
    dims: [ -1, -1 ]
  },
  {
    name: "sequence_length"
    data_type: TYPE_INT32
    dims: [ -1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

parameters {
  key: "max_beam_width"
  value: { string_value: "1" }
}
parameters {
  key: "gpt_model_type"
  value: { string_value: "inflight_fused_batching" }
}
parameters {
  key: "batch_scheduler_policy"
  value: { string_value: "max_utilization" }
}

# VRAM Budget (RTX 3060 Ti 8GB):
#   Gemma3 12B INT4 AWQ: ~5.5 GB
#   KV cache (paged, 4096 seq): ~1.5 GB
#   Overhead: ~0.5 GB
#   Total: ~7.5 GB
